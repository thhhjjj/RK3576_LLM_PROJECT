			15 00 02 AC 1A
			15 00 02 AD 19
			15 00 02 AE 4D
			15 00 02 AF 22
			15 00 02 B0 28
			15 00 02 B1 54
			15 00 02 B2 66
			15 00 02 B3 39
			// 4lane
			15 00 02 B7 02
			15 00 02 C0 00
			15 00 02 C1 1A
			15 00 02 C2 28
			15 00 02 C3 13
			15 00 02 C4 16
			15 00 02 C5 29
			15 00 02 C6 1D
			15 00 02 C7 1E
			15 00 02 C8 84
			15 00 02 C9 1C
			15 00 02 CA 28
			15 00 02 CB 75
			15 00 02 CC 1A
			15 00 02 CD 19
			15 00 02 CE 4D
			15 00 02 CF 22
			15 00 02 D0 28
			15 00 02 D1 54
			15 00 02 D2 66
			15 00 02 D3 39
			// Page 0
			39 00 04 FF 98 81 00
			// TE on
			05 00 01 35
			15 00 02 36 03
			// Sleep-out
			05 78 01 11
			// Display on
			05 78 01 29
		];

		panel-exit-sequence = [
			39 00 04 FF 98 81 00
			05 0A 01 28
			05 78 01 10
		];

		/* WKS50HD072-WCT SPEC §7 INPUT TIMING (Typ); note: ref only */
		disp_timings0: display-timings {
			native-mode = <&dsi_timing0>;
			dsi_timing0: timing0 {
				clock-frequency = <74250000>;
				hactive = <720>;
				vactive = <1280>;
				hfront-porch = <80>;
				hsync-len = <20>;
				hback-porch = <80>;
				vfront-porch = <16>;
				vsync-len = <8>;
				vback-porch = <24>;
				hsync-active = <0>;
				vsync-active = <0>;
				de-active = <0>;
				pixelclk-active = <0>;
			};
		};

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@0 {
				reg = <0>;
				panel_in_dsi: endpoint {
					remote-endpoint = <&dsi_out_panel>;
				};
			};
		};
	};

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@1 {
			reg = <1>;
			dsi_out_panel: endpoint {
				remote-endpoint = <&panel_in_dsi>;
			};
		};
	};

};

&dsi_in_vp0 {
	status = "disabled";
};

&dsi_in_vp1 {
	status = "okay";
};

&dsi_in_vp2 {
	status = "disabled";
};

&dsi_in_vopl {
	status = "disabled";
};

&mipidcphy0 {
	status = "okay";
};

&pwm1_6ch_1 {
	status = "okay";
	pinctrl-0 = <&pwm1m0_ch1>;
};


&route_dsi {
	status = "okay";
	connect = <&vp1_out_dsi>;
};

&vp1 {
	assigned-clocks = <&cru DCLK_VP1_SRC>;
	assigned-clock-parents = <&cru PLL_VPLL>;
};

&i2c0 {
	pinctrl-0 = <&i2c0m1_xfer>;
	status = "okay";

	myft5x06_0: my-ft5x06@38 {
        compatible = "focaltech,fts";
        reg = <0x38>; 
		status = "disabled";
 
        focaltech,reset-gpio = <&gpio0 RK_PD0 GPIO_ACTIVE_HIGH>;
        focaltech,irq-gpio = <&gpio0 RK_PC5 IRQ_TYPE_LEVEL_LOW>; 
 
        pinctrl-names = "default";
        pinctrl-0 = <&touch1_gpio>;

		focaltech,display-coords = <0 0 720 1280>;
		focaltech,max-touch-number = <10>;
 
    };

  	gt9xx:gt9xx@5d {
		compatible = "goodix,gt9xx";
		status = "okay";
		reg = <0x5d>;

		gtp_resolution_x = <720>;
		gtp_resolution_y = <1280>;
		gtp_int_tarigger = <1>;
		//gtp_change_x2y = <1>;
		//gtp_overturn_x = <1>;
		//gtp_overturn_y = <0>;
		gtp_send_cfg = <1>;
		gtp_touch_wakeup = <1>;
		goodix_rst_gpio = <&gpio0 RK_PD0 GPIO_ACTIVE_HIGH>;
		goodix_irq_gpio = <&gpio0 RK_PC5 IRQ_TYPE_LEVEL_LOW>; 
		pinctrl-names = "default";
		pinctrl-0 = <&touch1_gpio>;

		goodix,cfg-group0 = [
			49 D0 02 00 05 05 35 00 01 08
			1E 0A 50 3C 03 05 00 00 00 00
			00 00 00 18 1A 1E 14 8A 2A 0C
			96 98 B2 04 00 00 00 98 02 10
			00 00 00 00 00 00 00 00 00 00
			00 78 AA 94 C5 02 07 00 00 04
			96 7C 00 8D 85 00 86 8E 00 7D
			99 00 76 A4 00 76 00 00 00 00
			00 00 00 00 00 00 00 00 00 00
			00 00 00 00 00 00 00 00 00 00
			00 00 00 00 00 00 00 00 00 00
			00 00 18 16 14 12 10 0E 0C 0A
			08 06 04 02 FF FF FF FF FF FF
			FF FF FF FF FF FF FF FF FF FF
			FF FF 00 02 04 06 08 0A 0F 10
			12 13 24 22 21 20 1F 1E 1D 1C
			18 16 FF FF FF FF FF FF FF FF
			FF FF FF FF FF FF FF FF FF FF
			FF FF FF FF C8 01
		];
  	};
};

&pinctrl {
  touch1 {
    touch1_gpio: touch-gpio {
      rockchip,pins =
        <0 RK_PC5 RK_FUNC_GPIO &pcfg_pull_up>,
        <0 RK_PD0 RK_FUNC_GPIO &pcfg_pull_none>;
    };
  };
};
