# PHASE1 LLM terminal: keep what later stages need, drop demos/browsers/tests.
# librkllm is not a Buildroot package in this tree; stage it via overlay when ready.

BR2_PACKAGE_LIBDRM=y
BR2_PACKAGE_LIBCURL=y
BR2_PACKAGE_LIBCURL_CURL=y
BR2_PACKAGE_LIBCURL_OPENSSL=y
BR2_PACKAGE_CA_CERTIFICATES=y
BR2_PACKAGE_LIBWEBSOCKETS=y
BR2_PACKAGE_OPENSSL=y

# LVGL + DRM + our panel app (no music/widgets demo)
BR2_PACKAGE_LVGL=y
BR2_PACKAGE_LVGL_COLOR_DEPTH=32
BR2_PACKAGE_LVGL_USE_DRM=y
BR2_PACKAGE_LV_DRIVERS=y
BR2_PACKAGE_LV_DRIVERS_USE_DRM=y
BR2_PACKAGE_LIBEVDEV=y
BR2_PACKAGE_LLM_PANEL=y

# Bring-up / PHASE1 checks (small)
BR2_PACKAGE_EVTEST=y
BR2_PACKAGE_IW=y
BR2_PACKAGE_WIRELESS_TOOLS=y
BR2_PACKAGE_IPUTILS=y
BR2_PACKAGE_I2C_TOOLS=y
BR2_PACKAGE_PROCPS_NG=y
